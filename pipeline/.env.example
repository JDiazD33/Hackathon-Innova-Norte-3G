# Variables de entorno del pipeline. Copia este archivo a pipeline/.env (que no se sube) y
# completa los valores. Nunca subas el .env ni compartas el secreto.

# Secreto local para los seudónimos de los proveedores (HMAC-SHA256), de al menos 16 caracteres.
# Con el mismo secreto y los mismos datos, los seudónimos no cambian entre ejecuciones.
# Para generar uno: uv run python -c "import secrets; print(secrets.token_hex(32))"
PSEUDONYM_SECRET=
